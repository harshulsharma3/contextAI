NODE_ENV=development
PORT=4000

# Local docker-compose defaults (or Neon pooled + direct URLs)
DATABASE_URL=postgresql://contextai:contextai@localhost:5432/contextai
DIRECT_URL=postgresql://contextai:contextai@localhost:5432/contextai

REDIS_URL=redis://localhost:6379

# Optional Cloudflare R2 (falls back to ./uploads when unset)
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=contextai
LOCAL_UPLOAD_DIR=./uploads

LLM_PROVIDER=gemini
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
CHAT_MODEL=gemini-2.5-flash
LIGHT_MODEL=gemini-2.5-flash-lite
# Board diagrams ("Understand with images") via Gemini :generateContent
IMAGE_MODEL=gemini-2.5-flash-image
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Embedding throttle (free-tier friendly)
EMBED_BATCH_SIZE=4
EMBED_BATCH_DELAY_MS=1500
EMBED_MAX_CHUNKS=80
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=80

CORS_ALLOWED_ORIGINS=http://localhost:3000
# YT_PROXY_URL=
# SENTRY_DSN=
LOG_LEVEL=info
